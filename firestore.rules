rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tampilan TV IGD (public) dapat membaca semua data
    match /{document=**} {
      allow read: if true;
      // Hanya staf/admin yang sudah login dapat menulis/mengubah data
      allow write: if request.auth != null;
    }

    // Aturan Spesifik Koleksi Linen Management
    match /linenStock/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /linenTransactions/{trxId} {
      allow read: if true;
      // Transaksi ledger bersifat IMMUTABLE (hanya boleh create/insert baru, dilarang edit/delete)
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /linenSettings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
